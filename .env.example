# 复制成 .env 后填写：cp .env.example .env
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 模型：provider 前缀只在这里写一次
# 可选值：deepseek:deepseek-chat / deepseek:deepseek-reasoner
MODEL=deepseek:deepseek-chat

# 可选：LangSmith 追踪（强烈建议第 3 阶段开）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxx
# LANGCHAIN_PROJECT=lang-learn
